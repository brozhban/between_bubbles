---
import Page from '../../layouts/Page.astro'
import { IS_DRAFT, OPERATOR, field } from '../../legal'
---

<Page
	title="Contacts — Between Bubbles"
	description="How to reach the Between Bubbles team."
	noindex={IS_DRAFT}
	longform
	lang="en"
	alternatePath="/contacts"
>
	<p class="eyebrow">Legal</p>
	<h1>Contacts</h1>

	{
		IS_DRAFT && (
			<div class="notice">
				<p style="margin: 0">
					<strong>Draft.</strong> The rightholder's details have not been confirmed yet and
					are shown in square brackets.
				</p>
			</div>
		)
	}

	<h2>Support</h2>
	<p>
		Questions about the service, requests regarding the processing and deletion of data, and
		complaints about shared links —
		{' '}<a href={`mailto:${OPERATOR.email}`}>{field(OPERATOR.email, 'contact email address')}</a>.
		We respond within 30 days.
	</p>
	<p>
		You can delete your account and export your diary yourself in the settings; there is no
		need to write to us for that.
	</p>

	<h2>Rightholder</h2>
	<ul>
		<li>Name: {field(OPERATOR.name.en, 'operator name')}</li>
		<li>Registration: Tax ID {field(OPERATOR.registration, 'operator tax id')}</li>
		<li>Address: {field(OPERATOR.address.en, 'operator address')}</li>
		<li>
			Email: <a href={`mailto:${OPERATOR.email}`}>{field(OPERATOR.email, 'contact email address')}</a>
		</li>
	</ul>
</Page>

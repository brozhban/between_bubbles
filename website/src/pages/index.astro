---
import { Picture } from 'astro:assets'

import barrelHall from '../assets/barrel-hall.jpg'
import vineyardDusk from '../assets/vineyard-dusk.jpg'
import wineStorage from '../assets/wine-storage.jpg'
import Page from '../layouts/Page.astro'
import { WEBAPP_HOST } from '../legal'

/**
 * Лендинг в направлении «Виноградник на закате» (основа: INVERSA).
 *
 * Композиция героя повторяет замок референса: фотография уходит за края экрана,
 * заголовок прижат к нижней трети, а не стоит по центру, и на всей странице ровно
 * одна яркая точка — главная кнопка.
 *
 * Блоки с цифрами — это компонент stat-блока из того же референса, но в них
 * намеренно нет ничьей статистики. Показывать «14 вин за неделю» на витрине
 * значило бы придумать пользовательские данные; вместо этого блоки печатают факты
 * самого продукта, которые можно проверить в приложении.
 *
 * Все три кадра показывают место и ремесло: ни людей, ни разливания, ни крупных
 * планов бокала. Это не вкусовщина, а требование §3 и §8 самой оферты, где сказано,
 * что сервис не является рекламой алкоголя.
 *
 * Изображения декоративные: они задают настроение, но не несут информации, которой
 * нет в тексте рядом. Поэтому `alt` пустой — экранный диктор их пропускает, а не
 * зачитывает пересказ пейзажа.
 */
// localhost — только для `astro dev`: в продакшен-сборке запасным значением служит тот же хост,
// что оферта называет в предмете договора, а не адрес dev-сервера.
const webappUrl =
	import.meta.env.PUBLIC_WEBAPP_URL?.trim() ||
	(import.meta.env.DEV ? 'http://localhost:5173' : `https://${WEBAPP_HOST}`)
---

<Page
	title="Between Bubbles — винный дневник"
	description="Личный дневник дегустаций: неделя, оценки, вкусовой профиль и ваш справочник вин. Только для совершеннолетних."
	wide
>
	<section class="hero">
		<figure class="media">
			<Picture
				src={vineyardDusk}
				formats={['avif', 'webp']}
				widths={[640, 1024, 1600, 2560]}
				sizes="100vw"
				alt=""
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<div class="hero-inner">
			<p class="eyebrow">Between Bubbles</p>

			<dl class="stats">
				<div>
					<dt>Шкала оценки</dt>
					<dd>0.5–5.0</dd>
				</div>
				<div>
					<dt>Неделя</dt>
					<dd>Пн–Вс</dd>
				</div>
				<div>
					<dt>Выгрузка</dt>
					<dd>CSV · JSON</dd>
				</div>
			</dl>

			<h1>Записывайте вино так, чтобы потом вспомнить, каким оно было</h1>

			<p class="lede">
				Личный дневник дегустаций для осознанного потребления. Одна запись — одно вино в
				один день: оценка, вкусовой профиль, аромат и заметки. Неделя собирается сама.
			</p>

			<a class="cta" href={webappUrl}>Открыть дневник</a>
		</div>
	</section>

	<div class="shell">
		<section>
			<h2>Что внутри</h2>
			<p>
				Календарная неделя с метриками и диаграммами. Личный справочник вин со средним
				рейтингом по каждому вину. Повтор дегустации в один тап и отметка «та же бутылка»,
				чтобы траты не задваивались. Светлая и тёмная темы, русский и английский.
			</p>
		</section>

		<figure class="media inline">
			<Picture
				src={wineStorage}
				formats={['avif', 'webp']}
				widths={[640, 1024, 1600]}
				sizes="(min-width: 51rem) 48rem, 100vw"
				alt=""
				loading="lazy"
			/>
		</figure>

		<section>
			<h2>Приватность</h2>
			<p>
				Дневник личный: ваши записи, вина и фотографии видны только вам. Общей ленты,
				подписок и комментариев в продукте нет. Данные можно выгрузить или удалить вместе
				с аккаунтом.
			</p>
		</section>

		<figure class="media inline">
			<Picture
				src={barrelHall}
				formats={['avif', 'webp']}
				widths={[640, 1024, 1600]}
				sizes="(min-width: 51rem) 48rem, 100vw"
				alt=""
				loading="lazy"
			/>
		</figure>

		<div class="notice">
			<p style="margin: 0">
				<strong>18+.</strong> Регистрация доступна только совершеннолетним: при создании
				аккаунта запрашивается дата рождения. Чрезмерное употребление алкоголя вредит вашему
				здоровью. Сервис не даёт медицинских рекомендаций и не поощряет потребление.
			</p>
		</div>
	</div>
</Page>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: min(88svh, 46rem);
		overflow: hidden;
	}

	.media {
		margin: 0;
	}

	/*
	 * `Picture` оборачивает картинку в `<picture>`, а он по умолчанию строчный и без
	 * собственной высоты. Без этого правила `height: 100%` у картинки опирается на
	 * элемент с авто-высотой, и кадр держит размер случайно.
	 */
	.media :global(picture) {
		display: block;
		height: 100%;
	}

	.media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero .media {
		position: absolute;
		inset: 0;
	}

	/*
	 * Затемнение под текстом — не декорация, а условие читаемости: кремовый текст поверх
	 * закатного неба иначе не набирает контраст. Ставится только снизу, чтобы не гасить
	 * сам кадр, и уходит в цвет холста, чтобы стык героя со следующей секцией не был виден.
	 */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgb(20 21 15 / 42%),
			rgb(20 21 15 / 55%) 28%,
			rgb(20 21 15 / 85%) 68%,
			rgb(20 21 15 / 97%)
		);
		pointer-events: none;
	}

	.media.inline {
		margin: 3.6875rem 0;
		aspect-ratio: 2 / 1;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 3rem;
	}

	.eyebrow {
		margin: 0 0 2rem;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin: 0 0 1.75rem;
	}

	/*
	 * В герое мелкие подписи не берут приглушённый цвет системы: он рассчитан на ровный
	 * тёмный холст, а здесь под ними закатное небо. Светлый текст с пониженной
	 * непрозрачностью сохраняет ту же иерархию и не проваливается по контрасту.
	 */
	.hero .eyebrow,
	.stats dt {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text);
	}

	.stats dd {
		margin: 0.25rem 0 0;
		font-size: 1.8125rem;
		line-height: 1.25;
	}

	.lede {
		max-width: 34rem;
		margin: 1.25rem 0 2rem;
		color: var(--text);
	}

	.shell {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	.shell section:first-of-type h2 {
		margin-top: 3.6875rem;
	}
</style>

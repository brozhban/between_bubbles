---
/**
 * Общий каркас публичных страниц.
 *
 * Палитра и типографика повторяют DESIGN.md, но живут здесь автономно: website не тянет
 * стили из webapp, иначе статическая сборка зависела бы от клиентского пайплайна.
 */
interface Props {
	title: string
	description: string
	noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
	? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
	: undefined
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta name="twitter:card" content="summary" />
		<style is:global>
			:root {
				--bg: #dacabf;
				--surface: #efe3dc;
				--text: #444242;
				--text-muted: #595552;
				--border: #938a83;
				--accent-b: #aa9e54;
				--serif: 'Lora', 'EB Garamond', Georgia, serif;
				--sans: 'Inter', system-ui, sans-serif;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #062d32;
					--surface: #344b52;
					--text: #e9e9e2;
					--text-muted: #767676;
					--border: rgb(52 75 82 / 60%);
				}
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--sans);
				line-height: 1.5;
			}

			main {
				margin: 0 auto;
				max-width: 42rem;
				padding: 2.5rem 1.25rem 4rem;
			}

			h1,
			h2 {
				font-family: var(--serif);
				font-weight: 400;
				line-height: 1.2;
				margin: 0;
			}

			h1 {
				font-size: 1.75rem;
			}

			h2 {
				font-size: 1.25rem;
				margin-top: 2.5rem;
			}

			p {
				color: var(--text-muted);
			}

			a {
				color: var(--text);
			}

			.eyebrow,
			.nav a {
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-muted);
			}

			.cta {
				display: inline-block;
				border: 1px solid var(--text);
				padding: 0.875rem 1.5rem;
				text-decoration: none;
				font-size: 0.8125rem;
				letter-spacing: 0.07em;
				text-transform: uppercase;
			}

			.notice {
				border: 1px solid var(--border);
				background: var(--surface);
				padding: 1rem;
				margin-top: 2.5rem;
			}

			.nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				border-top: 1px solid var(--border);
				margin-top: 3rem;
				padding-top: 1.5rem;
			}
		</style>
	</head>
	<body>
		<main>
			<slot />
			<nav class="nav" aria-label="Правовая информация">
				<a href="/">Главная</a>
				<a href="/offer">Оферта</a>
				<a href="/privacy">Конфиденциальность</a>
				<a href="/contacts">Контакты</a>
			</nav>
		</main>
	</body>
</html>

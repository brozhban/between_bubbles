---
/**
 * Общий каркас публичных страниц.
 *
 * Палитра и типографика повторяют DESIGN.md, но живут здесь автономно: website не тянет
 * стили из webapp, иначе статическая сборка зависела бы от клиентского пайплайна.
 */
import type { Locale } from '@between-bubbles/contracts'

interface Props {
	title: string
	description: string
	noindex?: boolean
	/** Страница-документ: её читают целиком, а не просматривают. */
	longform?: boolean
	/** Язык страницы. Правовые документы существуют в двух версиях (рекомендация юриста). */
	lang?: Locale
	/** Адрес той же страницы на другом языке, если он есть. */
	alternatePath?: string
}

/**
 * Подписи навигации. Отдельного словаря i18n у статического сайта нет и не нужно:
 * четыре ссылки на два языка дешевле держать здесь, чем тянуть каталог из webapp.
 */
const navigation = {
	ru: {
		label: 'Правовая информация',
		links: [
			{ href: '/', text: 'Главная' },
			{ href: '/offer', text: 'Оферта' },
			{ href: '/privacy', text: 'Конфиденциальность' },
			{ href: '/contacts', text: 'Контакты' },
		],
		switchTo: 'English',
	},
	en: {
		label: 'Legal',
		links: [
			{ href: '/en/offer', text: 'Terms of Service' },
			{ href: '/en/privacy', text: 'Privacy Policy' },
			{ href: '/en/contacts', text: 'Contacts' },
		],
		switchTo: 'Русская версия',
	},
} satisfies Record<Locale, unknown>

const {
	title,
	description,
	noindex = false,
	longform = false,
	lang = 'ru',
	alternatePath,
} = Astro.props
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
	? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
	: undefined
/**
 * Astro собирает каталожные маршруты (`/offer/index.html`), поэтому canonical всегда со
 * слэшем на конце. hreflang обязан называть именно canonical-адрес другой версии: пара
 * проверяется взаимно, а адрес без слэша — это редирект, а не канон.
 *
 * Без известного публичного origin тег не выводим совсем: относительный `hreflang` невалиден,
 * а рядом стоящий canonical в этом случае тоже отсутствует.
 */
const alternateUrl =
	alternatePath && publicWebsiteUrl
		? new URL(alternatePath.endsWith('/') ? alternatePath : `${alternatePath}/`, publicWebsiteUrl)
				.toString()
		: undefined
const nav = navigation[lang]
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{
			alternateUrl && (
				<Fragment>
					<link rel="alternate" hreflang={lang === 'ru' ? 'en' : 'ru'} href={alternateUrl} />
					{canonicalUrl && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
				</Fragment>
			)
		}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta name="twitter:card" content="summary" />
		<style is:global>
			:root {
				--bg: #dacabf;
				--surface: #efe3dc;
				--text: #444242;
				--text-muted: #595552;
				--border: #938a83;
				--accent-b: #aa9e54;
				--serif: 'Lora', 'EB Garamond', Georgia, serif;
				--sans: 'Inter', system-ui, sans-serif;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #062d32;
					--surface: #344b52;
					--text: #e9e9e2;
					--text-muted: #767676;
					--border: rgb(52 75 82 / 60%);
				}
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--sans);
				line-height: 1.5;
			}

			main {
				margin: 0 auto;
				max-width: 42rem;
				padding: 2.5rem 1.25rem 4rem;
			}

			h1,
			h2 {
				font-family: var(--serif);
				font-weight: 400;
				line-height: 1.2;
				margin: 0;
			}

			h1 {
				font-size: 1.75rem;
			}

			h2 {
				font-size: 1.25rem;
				margin-top: 2.5rem;
			}

			p {
				color: var(--text-muted);
			}

			/* Правовые страницы держат перечисления в списках, поэтому они наследуют вид абзаца. */
			ul,
			ol {
				color: var(--text-muted);
				margin: 1rem 0 0;
				padding-left: 1.25rem;
			}

			li + li {
				margin-top: 0.75rem;
			}

			code {
				font-family: ui-monospace, 'SF Mono', Menlo, monospace;
				font-size: 0.875em;
				overflow-wrap: anywhere;
			}

			.version {
				font-size: 0.8125rem;
				margin-top: 0.75rem;
			}

			/*
			 * Правовые страницы читают целиком, поэтому их текст идёт основным цветом.
			 * Приглушённый оттенок из DESIGN.md рассчитан на короткие подписи лендинга и на
			 * странице документа даёт слабый контраст в тёмной теме.
			 */
			.longform p:not(.eyebrow),
			.longform li {
				color: var(--text);
			}

			a {
				color: var(--text);
			}

			.eyebrow,
			.nav a {
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-muted);
			}

			.cta {
				display: inline-block;
				border: 1px solid var(--text);
				padding: 0.875rem 1.5rem;
				text-decoration: none;
				font-size: 0.8125rem;
				letter-spacing: 0.07em;
				text-transform: uppercase;
			}

			.notice {
				border: 1px solid var(--border);
				background: var(--surface);
				padding: 1rem;
				margin-top: 2.5rem;
			}

			.nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				border-top: 1px solid var(--border);
				margin-top: 3rem;
				padding-top: 1.5rem;
			}
		</style>
	</head>
	<body>
		<main class:list={[{ longform }]}>
			<slot />
			<nav class="nav" aria-label={nav.label}>
				{nav.links.map((link) => <a href={link.href}>{link.text}</a>)}
				{alternatePath && <a href={alternatePath}>{nav.switchTo}</a>}
			</nav>
		</main>
	</body>
</html>

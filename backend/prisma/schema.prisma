generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Пользователь ----------

model User {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String?   @map("display_name")
  avatarKey       String?   @map("avatar_key")
  locale          String    @default("ru")
  theme           String    @default("system")
  timezone        String    @default("Asia/Tbilisi")
  defaultCurrency Currency  @default(GEL) @map("default_currency")
  birthDate       DateTime  @map("birth_date") @db.Date
  showSpendTotals Boolean   @default(false) @map("show_spend_totals")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")
  emailVerifiedAt DateTime? @map("email_verified_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      AuthSession[]
  authTokens    AuthToken[]
  weeks         Week[]
  wines         Wine[]
  entries       TastingEntry[]
  aromaTags     AromaTag[]
  photos        EntryPhoto[]
  shareLinks    ShareLink[]
  recentStores  UserStoreRecent[]

  @@index([deletedAt])
  @@map("users")
}

model AuthSession {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  refreshTokenFamilyHash   String?   @unique(map: "auth_sessions_refresh_token_family_hash_key") @map("refresh_token_family_hash")
  previousRefreshTokenHash String?   @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime? @map("refresh_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// Одноразовые ссылки из письма: восстановление пароля и подтверждение почты (ТЗ §13).
/// Хранится только хеш токена — по содержимому таблицы восстановить ссылку нельзя.
model AuthToken {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique(map: "auth_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_tokens_user_id_fkey")

  @@index([userId, kind], map: "auth_tokens_user_id_kind_idx")
  @@index([expiresAt], map: "auth_tokens_expires_at_idx")
  @@map("auth_tokens")
}

// ---------- Неделя ----------

model Week {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isoYear   Int      @map("iso_year")
  isoWeek   Int      @map("iso_week")
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "weeks_user_id_fkey")
  entries TastingEntry[]

  @@unique([userId, startDate], map: "weeks_user_id_start_date_key")
  @@index([userId, startDate], map: "weeks_user_id_start_date_idx")
  @@map("weeks")
}

// ---------- Вино (личный справочник) ----------

model Wine {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  name          String
  producer      String?
  originCountry String?     @map("origin_country") @db.Char(2)
  region        String?
  grapes        String[]
  vintage       Int?
  abv           Decimal?    @db.Decimal(3, 1)
  type          WineType
  sugar         SugarLevel?
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "wines_user_id_fkey")
  entries TastingEntry[]

  @@index([userId, name], map: "wines_user_id_name_idx")
  @@map("wines")
}

// ---------- Запись о дегустации ----------

model TastingEntry {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  wineId          String         @map("wine_id") @db.Uuid
  weekId          String         @map("week_id") @db.Uuid
  tastedOn        DateTime       @map("tasted_on") @db.Date
  volumeMl        Int            @map("volume_ml")
  rating          Decimal        @db.Decimal(2, 1)
  price           Decimal?       @db.Decimal(12, 2)
  currency        Currency?
  purchaseCountry String?        @map("purchase_country") @db.Char(2)
  storeId         String?        @map("store_id") @db.Uuid
  body            Body?
  acidity         Acidity?
  tannins         Tannins?
  tasteCategory   TasteCategory? @map("taste_category")
  aftertaste      Aftertaste?
  notes           String?
  sameBottleOfId  String?        @map("same_bottle_of_id") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "tasting_entries_user_id_fkey")
  wine           Wine           @relation(fields: [wineId], references: [id], onDelete: Restrict, map: "tasting_entries_wine_id_fkey")
  week           Week           @relation(fields: [weekId], references: [id], onDelete: Cascade, map: "tasting_entries_week_id_fkey")
  store          Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull, map: "tasting_entries_store_id_fkey")
  sameBottleOf   TastingEntry?  @relation("SameBottle", fields: [sameBottleOfId], references: [id], onDelete: SetNull, map: "tasting_entries_same_bottle_of_id_fkey")
  sameBottleRefs TastingEntry[] @relation("SameBottle")
  aromas         EntryAroma[]
  photos         EntryPhoto[]
  shareLinks     ShareLink[]

  @@index([userId, tastedOn], map: "tasting_entries_user_id_tasted_on_idx")
  @@index([userId, weekId], map: "tasting_entries_user_id_week_id_idx")
  @@index([wineId], map: "tasting_entries_wine_id_idx")
  @@index([userId, deletedAt], map: "tasting_entries_user_id_deleted_at_idx")
  @@map("tasting_entries")
}

model EntryAroma {
  entryId String @map("entry_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  entry TastingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, map: "entry_aromas_entry_id_fkey")
  tag   AromaTag     @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "entry_aromas_tag_id_fkey")

  @@id([entryId, tagId])
  @@index([tagId], map: "entry_aromas_tag_id_idx")
  @@map("entry_aromas")
}

model AromaTag {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  nameRu    String   @map("name_ru")
  nameEn    String?  @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")

  // Необязательная связь: у системных тегов владельца нет (`userId = null`).
  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "aroma_tags_user_id_fkey")
  entries EntryAroma[]

  @@unique([userId, nameRu], map: "aroma_tags_user_id_name_ru_key")
  @@index([userId], map: "aroma_tags_user_id_idx")
  @@map("aroma_tags")
}

// ---------- Фото ----------

model EntryPhoto {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId    String    @map("entry_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  kind       PhotoKind
  storageKey String    @map("storage_key")
  thumbKey   String    @map("thumb_key")
  width      Int
  height     Int
  sizeBytes  Int       @map("size_bytes")
  mimeType   String    @map("mime_type")
  createdAt  DateTime  @default(now()) @map("created_at")

  entry TastingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, map: "entry_photos_entry_id_fkey")
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "entry_photos_user_id_fkey")

  @@index([entryId], map: "entry_photos_entry_id_idx")
  @@index([userId], map: "entry_photos_user_id_idx")
  @@map("entry_photos")
}

// ---------- Общий справочник магазинов ----------

model Store {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  normalizedName  String      @map("normalized_name")
  countryCode     String      @map("country_code") @db.Char(2)
  city            String?
  kind            StoreKind   @default(OTHER)
  status          StoreStatus @default(ACTIVE)
  mergedIntoId    String?     @map("merged_into_id") @db.Uuid
  usageCount      Int         @default(0) @map("usage_count")
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  mergedInto   Store?            @relation("StoreMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull, map: "stores_merged_into_id_fkey")
  mergedFrom   Store[]           @relation("StoreMerge")
  entries      TastingEntry[]
  recentByUser UserStoreRecent[]

  @@unique([normalizedName, countryCode, city], map: "stores_normalized_name_country_code_city_key")
  @@index([countryCode, usageCount], map: "stores_country_code_usage_count_idx")
  @@index([createdByUserId, createdAt], map: "stores_created_by_user_id_created_at_idx")
  @@map("stores")
}

model UserStoreRecent {
  userId   String   @map("user_id") @db.Uuid
  storeId  String   @map("store_id") @db.Uuid
  useCount Int      @default(1) @map("use_count")
  lastUsed DateTime @default(now()) @map("last_used")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_store_recents_user_id_fkey")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "user_store_recents_store_id_fkey")

  @@id([userId, storeId])
  @@index([userId, lastUsed], map: "user_store_recents_user_id_last_used_idx")
  @@map("user_store_recents")
}

// ---------- Публичная ссылка ----------

model ShareLink {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entryId   String    @map("entry_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  slug      String    @unique(map: "share_links_slug_key")
  showName  Boolean   @default(false) @map("show_name")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  entry TastingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, map: "share_links_entry_id_fkey")
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "share_links_user_id_fkey")

  @@index([entryId], map: "share_links_entry_id_idx")
  @@index([userId], map: "share_links_user_id_idx")
  @@map("share_links")
}

// ---------- Перечисления ----------

enum Currency {
  GEL
  RUB
  USD
  EUR

  @@map("currency")
}

enum WineType {
  WHITE
  RED
  ROSE
  ORANGE
  SPARKLING

  @@map("wine_type")
}

enum SugarLevel {
  DRY
  SEMI_DRY
  SEMI_SWEET
  SWEET

  @@map("sugar_level")
}

enum Body {
  LIGHT
  MEDIUM
  FULL

  @@map("body")
}

enum Acidity {
  LOW
  MEDIUM
  HIGH

  @@map("acidity")
}

enum Tannins {
  GREEN
  ROUGH
  VELVET
  SILKY
  AGGRESSIVE
  NOT_APPLICABLE

  @@map("tannins")
}

enum Aftertaste {
  BALANCED
  LIGHT
  RICH
  HEAVY

  @@map("aftertaste")
}

enum TasteCategory {
  I
  II
  III
  IV
  V
  VI

  @@map("taste_category")
}

enum PhotoKind {
  BOTTLE
  LABEL

  @@map("photo_kind")
}

enum AuthTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("auth_token_kind")
}

enum StoreKind {
  SUPERMARKET
  WINE_SHOP
  RESTAURANT
  BAR
  ONLINE
  OTHER

  @@map("store_kind")
}

enum StoreStatus {
  ACTIVE
  HIDDEN
  MERGED

  @@map("store_status")
}
